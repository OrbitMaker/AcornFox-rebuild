# Open Card local IDC PoC configuration.
# Copy to config/cluster.env for local overrides. Do not put passwords,
# private keys, or Kubernetes tokens in this file.

CLUSTER_NAME=opencard

# Existing physical libvirt hosts.
SSH_USER=ubuntu
DEV_SSH_KEY=
TEST_SSH_KEY=
DEV_HOST=192.168.31.64
TEST_HOST=192.168.31.22

# The guest login user is the Ubuntu cloud-image default account.
VM_SSH_USER=ubuntu
VM_SSH_KEY=
VM_SSH_PUBLIC_KEY=

# The host NIC is discovered from the default route when set to auto.
DEV_PARENT_NIC=auto
TEST_PARENT_NIC=auto

# Local LAN static addressing. Bind these addresses in the LAN DHCP/static
# lease table before provisioning if the router enforces address ownership.
LAN_CIDR=192.168.31.0/24
LAN_GATEWAY=192.168.31.1
LAN_DNS_SERVERS=192.168.31.1,1.1.1.1

DEV_NODE_NAME=opencard-dev-01
DEV_NODE_IP=192.168.31.71
DEV_NODE_MAC=52:54:00:4f:43:01

TEST_NODE_01_NAME=opencard-test-01
TEST_NODE_01_IP=192.168.31.72
TEST_NODE_01_MAC=52:54:00:4f:43:02
TEST_NODE_02_NAME=opencard-test-02
TEST_NODE_02_IP=192.168.31.73
TEST_NODE_02_MAC=52:54:00:4f:43:03
TEST_NODE_03_NAME=opencard-test-03
TEST_NODE_03_IP=192.168.31.74
TEST_NODE_03_MAC=52:54:00:4f:43:04

# Each VM has a 30 GiB system disk plus a separate 20 GiB data disk. The data
# disk is deliberately left unformatted for Open-Local.
VM_ROOT_SIZE_GB=30
VM_DATA_SIZE_GB=20
VM_MEMORY_MB=4096
VM_VCPUS=4
VM_IMAGE_DIR=/var/lib/libvirt/images/opencard
VM_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
VM_IMAGE_SHA256=
VM_OS_VARIANT=ubuntu24.04

# Exact version required by the PoC. The installer fails on a mismatch.
K3S_VERSION=v1.34.10+k3s1
# K3s service components disabled for the small local cluster.
K3S_DISABLE_COMPONENTS=traefik,servicelb

# SSH behavior. accept-new avoids prompts for newly created guests while still
# refusing an unexpected key change for an existing host.
SSH_STRICT_HOST_KEY_CHECKING=accept-new
SSH_CONNECT_TIMEOUT=10
