[Unit]
Description=Prepare interrupted AcornFox upgrade recovery
Wants=network-online.target
After=local-fs.target network-online.target
Before=acornfox-upgrade-safe.target

[Service]
Type=oneshot
# Recovery validates the executing helper against the retained old/new journal.
# Keep initial host namespaces: the helper writes only its verified AcornFox scope.
ExecStart=/opt/acornfox/upgrade-tools/acornfox-upgrade recover-prepare --pending
TimeoutStartSec=15min
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
RequiredBy=acornfox-upgrade-safe.target
