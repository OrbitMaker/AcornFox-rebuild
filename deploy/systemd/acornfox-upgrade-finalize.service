[Unit]
Description=Finalize interrupted AcornFox upgrade recovery
After=acornfox-upgrade-safe.target
ConditionPathExists=/var/lib/acornfox/upgrade-in-progress

[Service]
Type=oneshot
# Recovery validates the executing helper against the retained old/new journal.
# Keep initial host namespaces: the helper writes only its verified AcornFox scope.
ExecStart=/opt/acornfox/upgrade-tools/acornfox-upgrade recover-finalize --pending
TimeoutStartSec=15min
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
