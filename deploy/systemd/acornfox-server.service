[Unit]
Description=AcornFox control-plane server
Wants=network-online.target acornfox-buildkit.service
Requires=acornfox-upgrade-safe.target
After=network-online.target acornfox-buildkit.service acornfox-upgrade-safe.target

[Service]
Type=simple
User=acornfox
Group=acornfox
SupplementaryGroups=acornfox-buildkit
WorkingDirectory=/opt/acornfox/current
Environment=ACORNFOX_RUNTIME_MODE=clean
Environment=ACORNFOX_SERVER_ADDR=127.0.0.1:18481
EnvironmentFile=/etc/acornfox/runtime/server.env
LoadCredential=server.key:/etc/acornfox/runtime/server.key
LoadCredential=acornfox-setup-token:/etc/acornfox/credentials/setup-token
EnvironmentFile=/opt/acornfox/active/database.env
ExecStart=/opt/acornfox/current/bin/acornfox-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectProc=invisible
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/acornfox/uploads /var/lib/acornfox/workspaces /var/lib/acornfox/build-work /var/lib/acornfox/oci /var/lib/acornfox/secrets /var/lib/acornfox/secret-materials /var/log/acornfox/server
BindReadOnlyPaths=-/run/acornfox-buildkit -/run/acornfox-build-policy
UMask=0077

[Install]
WantedBy=multi-user.target
