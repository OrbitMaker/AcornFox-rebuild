[Unit]
Description=AcornFox node agent
Wants=network-online.target
Requires=docker.service acornfox-upgrade-safe.target
After=network-online.target docker.service acornfox-upgrade-safe.target

[Service]
Type=simple
User=acornfox-agent
Group=acornfox-agent
SupplementaryGroups=docker acornfox
WorkingDirectory=/opt/acornfox/current
Environment=ACORNFOX_RUNTIME_MODE=clean
Environment=ACORNFOX_DOCKER_SOCKET=/var/run/docker.sock
EnvironmentFile=-/etc/acornfox/agent.env
ExecStart=/opt/acornfox/current/bin/acornfox-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectProc=invisible
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/acornfox/agent /var/log/acornfox/agent
ReadOnlyPaths=/var/lib/acornfox/oci
BindPaths=/var/run/docker.sock
UMask=0077

[Install]
WantedBy=multi-user.target
