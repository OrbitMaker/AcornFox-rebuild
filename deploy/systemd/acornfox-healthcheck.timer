[Unit]
Description=Run AcornFox host health check every minute
# Static 02C contract only; 03/04 must implement and bind the helper digest guard before activation.

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=1s
Persistent=true
Unit=acornfox-healthcheck.service

[Install]
WantedBy=timers.target
