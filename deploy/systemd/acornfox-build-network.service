[Unit]
Description=AcornFox isolated build network and policy attestation
Wants=docker.service
Requires=acornfox-upgrade-safe.target
After=docker.service acornfox-upgrade-safe.target
Before=acornfox-buildkit.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=root
Group=acornfox
RuntimeDirectory=acornfox-build-policy
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=ACORNFOX_RUNTIME_MODE=clean
ExecStart=/opt/acornfox/current/bin/acornfox-upgrade build-network-serve
ExecStartPost=/usr/bin/systemctl --no-block start acornfox-buildkit.service
ExecStopPost=/opt/acornfox/current/bin/acornfox-upgrade build-network-cleanup
TimeoutStartSec=30s
TimeoutStopSec=45s
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
# This fixed privileged helper must publish /run/netns in the host mount
# namespace. Filesystem namespace sandboxes would hide it from PID 1.
PrivateMounts=no
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_MAC_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
RestrictRealtime=yes
LockPersonality=yes
MemoryMax=128M
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
