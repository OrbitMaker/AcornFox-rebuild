[Unit]
Description=AcornFox public HTTPS edge Caddy
Wants=network-online.target
Requires=acornfox-upgrade-safe.target
After=network-online.target acornfox-upgrade-safe.target acornfox-server.service

[Service]
Type=notify
User=acornfox-edge
Group=acornfox-edge
WorkingDirectory=/var/lib/acornfox/edge
Environment=ACORNFOX_RUNTIME_MODE=clean
EnvironmentFile=/etc/acornfox/acornfox-edge.env
ExecStartPre=/opt/acornfox/current/bin/caddy validate --config /etc/acornfox/runtime/edge.json
ExecStart=/opt/acornfox/current/bin/caddy run --config /etc/acornfox/runtime/edge.json
ExecReload=/opt/acornfox/current/bin/caddy reload --address 127.0.0.1:2020 --config /etc/acornfox/runtime/edge.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
LimitNOFILE=1048576
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectProc=invisible
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/acornfox/edge /var/log/acornfox/edge
UMask=0077

[Install]
WantedBy=multi-user.target
