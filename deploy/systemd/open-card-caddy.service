[Unit]
Description=Open Card loopback Caddy proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=opencard-caddy
Group=opencard-caddy
WorkingDirectory=/var/lib/open-card-caddy
StateDirectory=open-card-caddy
StateDirectoryMode=0750
LogsDirectory=open-card-caddy
LogsDirectoryMode=0750
EnvironmentFile=-/etc/open-card/caddy.env
Environment=OPEN_CARD_CADDY_LISTEN=127.0.0.1:8080
ExecStartPre=/usr/bin/test -r /etc/open-card/Caddyfile
ExecStartPre=/usr/bin/grep -Eq ^[[:space:]]*http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+ /etc/open-card/Caddyfile
ExecStart=/opt/open-card/current/bin/caddy run --environ --config /etc/open-card/Caddyfile --adapter caddyfile
ExecReload=/opt/open-card/current/bin/caddy reload --config /etc/open-card/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/open-card-caddy /var/log/open-card-caddy
UMask=0077

[Install]
WantedBy=multi-user.target
