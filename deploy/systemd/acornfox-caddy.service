[Unit]
Description=AcornFox loopback Caddy proxy
Wants=network-online.target
Requires=acornfox-upgrade-safe.target
After=network-online.target acornfox-upgrade-safe.target

[Service]
Type=simple
User=acornfox-caddy
Group=acornfox-caddy
WorkingDirectory=/var/lib/acornfox/caddy
Environment=ACORNFOX_RUNTIME_MODE=clean
ExecStartPre=/usr/bin/test -r /etc/acornfox/Caddyfile
ExecStartPre=/usr/bin/grep -Eq ^[[:space:]]*http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+ /etc/acornfox/Caddyfile
ExecStart=/opt/acornfox/current/bin/caddy run --environ --config /etc/acornfox/Caddyfile --adapter caddyfile
ExecReload=/opt/acornfox/current/bin/caddy reload --config /etc/acornfox/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/acornfox/caddy /var/log/acornfox/caddy
UMask=0077

[Install]
WantedBy=multi-user.target
