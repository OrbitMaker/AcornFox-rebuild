[Unit]
Description=AcornFox upgrade-safe boot barrier
# Static 02C contract only; 03/04 activation must verify helper digest and AcornFox roots.
Requires=acornfox-upgrade-recover.service
Wants=acornfox-upgrade-finalize.service
After=acornfox-upgrade-recover.service
Before=acornfox-buildkit.service acornfox-caddy.service acornfox-server.service acornfox-agent.service acornfox-edge.service acornfox-upgrade-finalize.service

[Install]
WantedBy=multi-user.target
RequiredBy=acornfox-buildkit.service acornfox-caddy.service acornfox-server.service acornfox-agent.service acornfox-edge.service
