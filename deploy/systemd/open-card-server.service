[Unit]
Description=Open Card control-plane server
Wants=network-online.target
Requires=open-card-buildkit.service
After=network-online.target open-card-buildkit.service

[Service]
Type=simple
User=opencard
Group=opencard
SupplementaryGroups=opencard-buildkit
WorkingDirectory=/opt/open-card/current
EnvironmentFile=-/etc/open-card/server.env
EnvironmentFile=/opt/open-card/active/database.env
ExecStart=/opt/open-card/current/bin/open-card-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectProc=invisible
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/open-card /var/log/open-card
BindReadOnlyPaths=/run/open-card-buildkit
UMask=0077

[Install]
WantedBy=multi-user.target
