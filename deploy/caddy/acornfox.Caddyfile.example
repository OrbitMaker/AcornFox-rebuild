{
	admin 127.0.0.1:2019
	auto_https off
}

# This internal proxy is a package source for the future local config path.
# It does not publish a DNS name, certificate, or public listener.
http://127.0.0.1:8080 {
	bind 127.0.0.1
	@backend path /api /api/* /healthz /readyz
	handle @backend {
		reverse_proxy 127.0.0.1:18481 {
			# Preserve the HTTPS scheme established by the loopback Edge hop.
			# Public clients never connect directly to this listener.
			trusted_proxies 127.0.0.1/32
		}
	}
	handle {
		root * /opt/acornfox/current/web/dist
		try_files {path} /index.html
		file_server
	}
}
