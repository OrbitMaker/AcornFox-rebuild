{
  "name": "acornfox-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.core.config.ts --host 127.0.0.1 --port 4175",
    "build": "tsc -p tsconfig.core.json --noEmit && VITE_API_MODE=live VITE_API_BASE_URL=/api/v1 vite build --config vite.core.config.ts",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "test": "vitest run src/core",
    "lint": "eslint src"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "2.102.0",
    "@douyinfe/semi-ui": "2.102.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "8.2.2",
    "vitest": "3.2.7"
  }
}
