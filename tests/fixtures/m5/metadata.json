{
  "schema_version": 1,
  "fixture_id": "m5-usage-foundation",
  "test_ids": [
    "UNIT-USAGE-001",
    "CT-METER-001",
    "USAGE-INT-001",
    "E2E-USAGE-001",
    "USAGE-001",
    "USAGE-002",
    "USAGE-003"
  ],
  "metric_units": {
    "cpu": "millicores",
    "memory": "bytes",
    "disk": "bytes",
    "network": "bytes",
    "runtime": "seconds",
    "restart_count": "count"
  },
  "window": {
    "timezone": "UTC",
    "interval": "[from,to)",
    "bucket_width_seconds": 300
  },
  "facts": {
    "source": "independent_observation",
    "identity": "source_id",
    "ordering": "observed_at",
    "duplicate_policy": "same_identity_same_payload_is_noop",
    "conflict_policy": "same_identity_changed_payload_is_rejected"
  },
  "retention": {
    "raw_seconds": 604800,
    "aggregate_seconds": 7776000,
    "audit_policy": "retain"
  },
  "capabilities": {
    "local_usage_facts": true,
    "authorized_summary_context": true,
    "automatic_resource_mutation": false,
    "model_dependency": false
  }
}
