[Unit]
Description=Open Card rootless BuildKit fixture unit

[Service]
User=opencard-buildkit
WorkingDirectory=/var/lib/open-card-buildkit
ExecStart=/opt/open-card/current/bin/buildkitd --root /var/lib/open-card-buildkit/buildkitd --addr unix:///run/open-card-buildkit/buildkitd.sock
Restart=on-failure

[Install]
WantedBy=multi-user.target
