{
  "schema_version": 1,
  "fixture_id": "m7-rc-foundation",
  "milestone": "M7",
  "test_ids": [
    "INSTALL-001",
    "INSTALL-002",
    "INSTALL-003",
    "UPGRADE-001",
    "UPGRADE-002",
    "UPGRADE-003",
    "UPGRADE-004",
    "UPGRADE-005",
    "RC-SUPPLY-001",
    "BACKUP-RESTORE-001",
    "REBOOT-RECOVERY-001",
    "FAULT-RC-001",
    "SECURITY-RC-001",
    "E2E-RC-001",
    "REGRESSION-RC-001",
    "HOST-RECLAIM-001"
  ],
  "support_matrix": {
    "os": "Ubuntu 24.04 LTS",
    "architecture": "amd64",
    "network_modes": ["online-explicit", "offline-bundle"],
    "docker": "external-preflight",
    "systemd": true,
    "autostart": true
  },
  "directory_contract": {
    "release_root": "/opt/open-card",
    "config_root": "/etc/open-card",
    "data_root": "/var/lib/open-card",
    "current_pointer": "/opt/open-card/current",
    "previous_pointer": "/opt/open-card/previous",
    "backup_root": "/var/lib/open-card/backups",
    "evidence_root": "/var/lib/open-card/evidence"
  },
  "units": [
    "open-card-server.service",
    "open-card-agent.service",
    "open-card-buildkit.service",
    "open-card-caddy.service"
  ],
  "contracts": {
    "install_is_staged_before_activation": true,
    "offline_requires_explicit_bundle": true,
    "upgrade_creates_backup_before_pointer_change": true,
    "failed_health_restores_previous_pointer": true,
    "uninstall_preserves_data_by_default": true,
    "purge_requires_exact_confirmation": true,
    "migration_failure_is_transactional": true,
    "database_restore_import_is_explicit": true,
    "m7_gate_requires_real_evidence": true
  },
  "evidence_policy": {
    "required_types": [
      "terminal",
      "systemd",
      "version",
      "migration",
      "filesystem_snapshot",
      "database_checksum",
      "network_boundary",
      "junit"
    ],
    "weak_only_is_insufficient": ["http_200", "container_exists"],
    "unrun_status": "NOT_RUN"
  }
}
