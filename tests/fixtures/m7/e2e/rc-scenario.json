{
  "schema_version": 1,
  "id": "E2E-RC-001",
  "status": "RUNNER_CONTRACT_ONLY",
  "ai_enabled": false,
  "steps": [
    {"step": 1, "test_id": "INSTALL-001", "action": "clean_host_preflight_and_online_install", "must_observe": ["units_active", "health", "permissions"]},
    {"step": 2, "test_id": "INSTALL-002", "action": "offline_bundle_install_with_network_denied", "must_observe": ["manifest_checksum", "no_external_network", "units_active"]},
    {"step": 3, "test_id": "REBOOT-RECOVERY-001", "action": "guest_reboot_and_recovery", "must_observe": ["enabled_units", "durable_operation_recovery", "serving_route"]},
    {"step": 4, "test_id": "UPGRADE-001", "action": "n_minus_one_to_n_upgrade", "must_observe": ["migration_version", "version_identity", "traffic"]},
    {"step": 5, "test_id": "UPGRADE-002", "action": "migration_failure_and_rollback", "must_observe": ["old_release", "old_data_version", "no_half_state"]},
    {"step": 6, "test_id": "BACKUP-RESTORE-001", "action": "verified_backup_restore", "must_observe": ["archive_checksum", "db_checksum", "audit_chain", "volume_checksum"]},
    {"step": 7, "test_id": "INSTALL-003", "action": "preserve_by_default_uninstall", "must_observe": ["units_removed", "data_preserved", "evidence_preserved"]},
    {"step": 8, "test_id": "HOST-RECLAIM-001", "action": "task_resource_reclaim_and_host_diff", "must_observe": ["task_resources_absent", "non_task_resources_unchanged"]}
  ],
  "completion_rules": {
    "all_steps_need_independent_evidence": true,
    "http_status_only_is_insufficient": true,
    "container_presence_only_is_insufficient": true,
    "failed_step_is_not_pass": true
  }
}
