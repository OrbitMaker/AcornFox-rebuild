{
  "version": "3.9",
  "services": {
    "db": {
      "image": "registry.example.test/opencard/postgres@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "environment": {
        "POSTGRES_DB": "opencard",
        "POSTGRES_USER": "app"
      },
      "volumes": [
        {
          "source": "db-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume"
        }
      ],
      "healthcheck": {
        "test": ["CMD-SHELL", "pg_isready -U app -d opencard"],
        "interval": "5s",
        "timeout": "2s",
        "retries": 3
      },
      "restart": "unless-stopped",
      "networks": ["private"],
      "resources": {
        "cpus": "1",
        "memory": "256MiB"
      }
    },
    "api": {
      "image": "registry.example.test/opencard/api@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "entrypoint": ["/bin/api"],
      "command": ["serve"],
      "environment": {
        "APP_ENV": "fixture",
        "DATABASE_HOST": "db"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": ["CMD", "/bin/api-health"],
        "interval": "10s",
        "timeout": "2s",
        "start_period": "5s",
        "retries": 3
      },
      "restart": "always",
      "networks": ["private"],
      "resources": {
        "cpus": "500m",
        "memory": "128MiB"
      }
    },
    "worker": {
      "build": {
        "context": ".",
        "dockerfile": "deploy/worker.Dockerfile"
      },
      "entrypoint": ["/bin/worker"],
      "command": ["--queue", "default"],
      "environment": {
        "APP_ENV": "fixture",
        "API_HOST": "api"
      },
      "depends_on": {
        "api": {
          "condition": "service_started"
        }
      },
      "restart": "on-failure",
      "networks": ["private"],
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "250m",
            "memory": "64MiB"
          }
        }
      }
    },
    "web": {
      "build": {
        "context": ".",
        "dockerfile": "deploy/web.Dockerfile"
      },
      "entrypoint": ["/bin/web"],
      "command": ["--upstream", "http://api:8080"],
      "environment": {
        "PUBLIC_MODE": "fixture"
      },
      "ports": [
        {
          "target": 8080,
          "protocol": "tcp"
        }
      ],
      "depends_on": {
        "api": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": ["CMD", "/bin/web-health"],
        "interval": "10s",
        "timeout": "2s",
        "retries": 3
      },
      "restart": "always",
      "networks": ["private"],
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "500m",
            "memory": "128MiB"
          }
        }
      }
    }
  },
  "networks": {
    "private": {
      "internal": true
    }
  },
  "volumes": {
    "db-data": {}
  }
}
