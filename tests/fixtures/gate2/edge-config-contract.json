{
  "fixture_id": "gate2-edge-config-contract-v1",
  "edge": {
    "listen": ["tcp:80", "tcp:443"],
    "protocols": ["h1", "h2"],
    "admin": "127.0.0.1:2020",
    "state_dir": "/var/lib/open-card-edge",
    "log_dir": "/var/log/open-card-edge",
    "grace_period_seconds": 30,
    "stop_timeout_seconds": 45,
    "keepalive_seconds": 30,
    "read_header_timeout_seconds": 5,
    "idle_timeout_seconds": 120,
    "dial_timeout_seconds": 3,
    "response_header_timeout_seconds": 30,
    "metrics_admin_only": true
  },
  "internal_route_provider": {
    "listen": "127.0.0.1:18481",
    "admin": "127.0.0.1:2019"
  },
  "routes": {
    "console_host": "console.example.invalid",
    "api_before_spa": true,
    "api_upstream": "127.0.0.1:8080",
    "app_upstream": "127.0.0.1:18481",
    "tls_allow": "http://127.0.0.1:8080/internal/tls/allow",
    "strip_identity_headers": ["Open-Card-*", "X-Open-Card-*"],
    "trusted_client_source_header": {
      "name": "X-Open-Card-Client-IP",
      "value": "{remote_host}",
      "scope": "console_api_only"
    }
  },
  "forbidden": ["h3", "udp:443", "read_body", "public metrics", "pprof", "real domain", "certificate", "token", "password"]
}
