{
  "schema_version": 1,
  "contract_id": "gate2-edge-network-v1",
  "approved_tcp_ports": [80, 443],
  "forbidden_tcp_ports": [8080, 18481, 2019, 2020, 5432, 8092],
  "forbidden_unix_sockets": [
    "/var/run/docker.sock",
    "/run/docker.sock",
    "/run/open-card-buildkit/buildkitd.sock"
  ],
  "observation_points": {
    "local": ["listener", "process", "systemd", "unix_socket"],
    "external": ["tcp_probe"]
  },
  "required_arguments": ["observation_point", "target", "task_id", "evidence_dir", "confirm"],
  "confirmation": "GATE2-NETWORK-READONLY",
  "external_probe": {
    "target_must_not_be_loopback": true,
    "probe_origin_required": true,
    "unexecuted_status": "unknown"
  },
  "statuses": ["pass", "fail", "unknown"],
  "exit_codes": {
    "pass": 0,
    "fail": 1,
    "unknown": 2,
    "usage": 64
  }
}
