{
  "version": "3.9",
  "services": {
    "db": {
      "image": "127.0.0.1:45532/opencard/m2/db:stable",
      "volumes": [{"source": "db-data", "target": "/var/lib/opencard/data", "type": "volume"}],
      "healthcheck": {"test": ["CMD", "/open-card-static-server", "-healthcheck"], "interval": "2s", "timeout": "1s", "retries": 3},
      "restart": "unless-stopped",
      "networks": ["private"],
      "resources": {"cpus": "150m", "memory": "64MiB"}
    },
    "api": {
      "build": {"context": "services/api", "dockerfile": "Dockerfile"},
      "environment": {"APP_ENV": "m2-fixture-v2", "DATABASE_HOST": "db"},
      "depends_on": {"db": {"condition": "service_healthy"}},
      "healthcheck": {"test": ["CMD", "/open-card-static-server", "-healthcheck"], "interval": "2s", "timeout": "1s", "retries": 3},
      "restart": "always",
      "networks": ["private"],
      "resources": {"cpus": "150m", "memory": "64MiB"}
    },
    "worker": {
      "build": {"context": "services/worker", "dockerfile": "Dockerfile"},
      "environment": {"APP_ENV": "m2-fixture-v2", "API_HOST": "api"},
      "depends_on": {"api": {"condition": "service_started"}},
      "restart": "on-failure",
      "networks": ["private"],
      "resources": {"cpus": "150m", "memory": "64MiB"}
    },
    "frontend": {
      "build": {"context": "services/frontend-v2", "dockerfile": "Dockerfile"},
      "environment": {"PUBLIC_MODE": "m2-v2"},
      "ports": [{"target": 8080, "protocol": "tcp"}],
      "depends_on": {"api": {"condition": "service_healthy"}},
      "healthcheck": {"test": ["CMD", "/open-card-static-server", "-healthcheck"], "interval": "2s", "timeout": "1s", "retries": 6},
      "restart": "always",
      "networks": ["private"],
      "resources": {"cpus": "300m", "memory": "128MiB"}
    }
  },
  "networks": {"private": {"internal": true}},
  "volumes": {"db-data": {}}
}
