{
  "name": "open-card-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175",
    "build": "tsc --noEmit && vite build",
    "build:core": "tsc -p tsconfig.core.json --noEmit && vite build --config vite.core.config.ts",
    "build:stub": "VITE_API_MODE=stub VITE_API_BASE_URL=/api/v1 tsc --noEmit && VITE_API_MODE=stub VITE_API_BASE_URL=/api/v1 vite build --mode stub",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:acornfox-api": "node scripts/generate-acornfox-api.mjs",
    "check:acornfox-api": "node scripts/generate-acornfox-api.mjs --check",
    "lint": "eslint . --ignore-pattern dist-stub",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "test": "vitest run --exclude scripts/live-build-contract.test.mjs --exclude scripts/acornfox-artifact.test.mjs --exclude scripts/release-build-contract.test.mjs --exclude src/acornfox/parity.test.ts",
    "test:build-contract": "node --test scripts/live-build-contract.test.mjs",
    "test:release-build-contract": "node --test scripts/release-build-contract.test.mjs",
    "test:acornfox-artifact": "node --test scripts/acornfox-artifact.test.mjs",
    "test:acornfox-parity": "node scripts/acornfox-parity.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "2.102.0",
    "@douyinfe/semi-ui": "2.102.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "eslint": "9.35.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "8.2.2",
    "vitest": "3.2.7"
  }
}
